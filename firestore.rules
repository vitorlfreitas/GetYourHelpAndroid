rules_version = '2';

// Security rules for GetYourHelp. These run on Firebase's servers and are the real access control
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function taskExists(taskId) {
      return exists(/databases/$(database)/documents/tasks/$(taskId));
    }

    function taskOwner(taskId) {
      return signedIn() && taskExists(taskId) &&
        get(/databases/$(database)/documents/tasks/$(taskId)).data.ownerId == request.auth.uid;
    }

    function taskHelper(taskId) {
      return signedIn() && taskExists(taskId) &&
        get(/databases/$(database)/documents/tasks/$(taskId)).data.assignedHelperId == request.auth.uid;
    }

    // Users can only read and write their own profile
    match /users/{uid} {
      allow create, read, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // Any signed-in user can read tasks. Only the owner can create or edit one, and only delete it while it is still OPEN
    match /tasks/{taskId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'OPEN';
      allow update: if signedIn() && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid
        && resource.data.status == 'OPEN';
    }

    // A helper can apply to someone else's OPEN task
    // Applications are visible to the helper and the task owner
    // The owner can accept/decline while the helper can only withdraw
    match /applications/{applicationId} {
      allow read: if signedIn() && (
        resource.data.helperId == request.auth.uid || taskOwner(resource.data.taskId)
      );
      allow create: if signedIn()
        && request.resource.data.helperId == request.auth.uid
        && taskExists(request.resource.data.taskId)
        && get(/databases/$(database)/documents/tasks/$(request.resource.data.taskId)).data.ownerId != request.auth.uid
        && get(/databases/$(database)/documents/tasks/$(request.resource.data.taskId)).data.status == 'OPEN'
        && request.resource.data.status == 'PENDING';
      allow update: if signedIn() && (
        taskOwner(resource.data.taskId) ||
        (resource.data.helperId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
          request.resource.data.status == 'WITHDRAWN')
      );
      allow delete: if false;
    }

    // Payment records are visible only to the payer and payee
    match /paymentRecords/{recordId} {
      allow read: if signedIn() &&
        (resource.data.payerId == request.auth.uid || resource.data.payeeId == request.auth.uid);
      allow create: if signedIn() &&
        (request.resource.data.payerId == request.auth.uid || request.resource.data.payeeId == request.auth.uid)
        && taskExists(request.resource.data.taskId);
      allow update: if signedIn() &&
        (resource.data.payerId == request.auth.uid || resource.data.payeeId == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if false;
    }

    // Any signed-in user can report an existing task. Reports cannot be edited or deleted
    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid
        && taskExists(request.resource.data.taskId);
      allow read: if signedIn() && resource.data.reporterId == request.auth.uid;
      allow update, delete: if false;
    }

    // Reviews (rating 1-5) can only be written for a COMPLETED task
    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.reviewerId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && taskExists(request.resource.data.taskId)
        && get(/databases/$(database)/documents/tasks/$(request.resource.data.taskId)).data.status == 'COMPLETED'
        && request.auth.uid in [
          get(/databases/$(database)/documents/tasks/$(request.resource.data.taskId)).data.ownerId,
          get(/databases/$(database)/documents/tasks/$(request.resource.data.taskId)).data.assignedHelperId
        ]
        && request.resource.data.revieweeId in [
          get(/databases/$(database)/documents/tasks/$(request.resource.data.taskId)).data.ownerId,
          get(/databases/$(database)/documents/tasks/$(request.resource.data.taskId)).data.assignedHelperId
        ]
        && request.resource.data.revieweeId != request.auth.uid;
      allow update, delete: if false;
    }
  }
}
